PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend.example.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/beyond_grades?retryWrites=true&w=majority

# Cloudinary media storage (preferred: single URL)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or individual vars:
# CLOUDINARY_CLOUD_NAME=replace-me
# CLOUDINARY_API_KEY=replace-me
# CLOUDINARY_API_SECRET=replace-me

# Optional: used only by scripts/migrate-spaces-to-cloudinary.js to detect legacy URLs
DO_SPACES_CDN_BASE=https://cdn.touchapp.live

# Prefer this base64 env var in deployment.
FIREBASE_SERVICE_ACCOUNT_BASE64=replace-me

# Or use this single JSON env var in deployment.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me","private_key":"replace-me","client_email":"replace-me"}

# Or use these three instead of FIREBASE_SERVICE_ACCOUNT_JSON.
# FIREBASE_PROJECT_ID=replace-me
# FIREBASE_CLIENT_EMAIL=replace-me
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
PUBLIC_PROFILE_BASE_URL=https://beyondgrades.app/profile
